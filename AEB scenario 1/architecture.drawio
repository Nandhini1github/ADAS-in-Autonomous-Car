        <mxCell id="scenario" value="Lead-vehicle scenario: 60 mph rolling start for both vehicles&#xa;Speed PID + pure-pursuit steering; hold both speeds within ±1 mph for 1.5 s&#xa;Then command 100% lead brake; CARLA physics determines the stop" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;fillColor=#fff4dd;strokeColor=#ba8c37;strokeWidth=2;fontFamily=Arial;fontSize=21;fontColor=#172b4d;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="115" width="980" height="105" as="geometry" /></mxCell>
